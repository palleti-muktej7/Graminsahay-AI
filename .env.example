# GraminSahay AI Configuration
# Supabase PostgreSQL Integration

# 1. Supabase Project URL & Anon/Service Key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# 2. Direct PostgreSQL Database Connection URI (From Supabase -> Project Settings -> Database -> Connection URI)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# 3. Optional Gemini API Key for dynamic LLM insights
GEMINI_API_KEY=
